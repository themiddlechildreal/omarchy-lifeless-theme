# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1a1f2b"

# Main text color
theme[main_fg]="#dcd6ce"

# Title color for boxes
theme[title]="#dcd6ce"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#abfeff"

# Background color of selected item in processes box
theme[selected_bg]="#2c3547"

# Foreground color of selected item in processes box
theme[selected_fg]="#abfeff"

# Color of inactive/disabled text
theme[inactive_fg]="#262d3a"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#e8e3da"

# Background color of the percentage meters
theme[meter_bg]="#2c3547"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#e8e3da"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#abf6fd"
theme[mem_box]="#4cd5b5"
theme[net_box]="#55d8c5"
theme[proc_box]="#abfeff"

# Box divider line and small boxes line color
theme[div_line]="#262d3a"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#4cd5b5"
theme[temp_mid]="#23ac97"
theme[temp_end]="#55d8c5"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#77e0f8"
theme[cpu_mid]="#9ff0d5"
theme[cpu_end]="#abf6fd"

# Mem/Disk free meter
theme[free_start]="#abf6fd"
theme[free_mid]="#9ff0d5"
theme[free_end]="#77e0f8"

# Mem/Disk cached meter
theme[cached_start]="#9ff0d5"
theme[cached_mid]="#77e0f8"
theme[cached_end]="#abf6fd"

# Mem/Disk available meter
theme[available_start]="#23ac97"
theme[available_mid]="#55d8c5"
theme[available_end]="#55d8c5"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#4cd5b5"
theme[used_mid]="#77e0f8"
theme[used_end]="#9ff0d5"

# Download graph colors
theme[download_start]="#23ac97"
theme[download_mid]="#55d8c5"
theme[download_end]="#55d8c5"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#4cd5b5"
theme[upload_mid]="#77e0f8"
theme[upload_end]="#9ff0d5"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#77e0f8"
theme[process_mid]="#9ff0d5"
theme[process_end]="#abf6fd"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#1a1f2b"
theme[gradient_color_1]="#242b3a"
theme[gradient_color_2]="#2c3547"
theme[gradient_color_3]="#262d3a"
theme[gradient_color_4]="#948e91"
theme[gradient_color_5]="#dcd6ce"
theme[gradient_color_6]="#e8e3da"
theme[gradient_color_7]="#f5f1e8"
